{
  "uid": "fivexbread-reservation",
  "title": "5XBread 예약 v1/v2",
  "tags": [
    "5xbread"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "uri",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count, uri)",
          "refId": "v"
        },
        "definition": "label_values(http_server_requests_seconds_count, uri)",
        "current": {
          "text": "/api/v1/reservations",
          "value": "/api/v1/reservations"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "regex": "/^\\/api\\//",
        "sort": 1
      },
      {
        "name": "method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count{uri=~\"${uri:regex}\"}, method)",
          "refId": "v"
        },
        "definition": "label_values(http_server_requests_seconds_count{uri=~\"${uri:regex}\"}, method)",
        "current": {
          "text": "POST",
          "value": "POST"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "요청 시간 p50·p95·p99 (앱 3개 합산)",
      "description": "http.server.requests 히스토그램 버킷을 앱 3개 합쳐 계산. 기본은 예약 POST",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"${uri:regex}\", method=~\"${method:regex}\"}[30s])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"${uri:regex}\", method=~\"${method:regex}\"}[30s])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"${uri:regex}\", method=~\"${method:regex}\"}[30s])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "초당 처리 수 (상태별)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"${uri:regex}\", method=~\"${method:regex}\"}[30s]))",
          "legendFormat": "{{status}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"${uri:regex}\", method=~\"${method:regex}\"}[30s]))",
          "legendFormat": "합계"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HikariCP active·pending (앱별)",
      "description": "pending 이 0보다 크면 DB 커넥션을 기다리는 요청이 있다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "hikaricp_connections_active{pool=~\".+\"}",
          "legendFormat": "active {{app}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "hikaricp_connections_pending{pool=~\".+\"}",
          "legendFormat": "pending {{app}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max(hikaricp_connections_max)",
          "legendFormat": "max (풀 크기)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Redis 명령 시간 p95 (명령별, 앱 3개 합산)",
      "description": "Lettuce 명령 완료 시간. 예약 Lua 는 EVALSHA",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, command) (rate(lettuce_command_completion_seconds_bucket[30s])))",
          "legendFormat": "p95 {{command}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (command) (rate(lettuce_command_completion_seconds_sum[30s])) / sum by (command) (rate(lettuce_command_completion_seconds_count[30s]))",
          "legendFormat": "평균 {{command}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5xx 수 (30초 구간, 앱별)",
      "description": "모든 URI. 0이 아니면 어느 앱에서 났는지 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
