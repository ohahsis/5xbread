          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (command) (rate(lettuce_command_completion_seconds_count[30s]))",
          "legendFormat": "{{command}}"
        }
