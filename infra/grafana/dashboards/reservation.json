          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (app) (increase(http_server_requests_seconds_count{status=~\"5..\"}[30s]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis 명령 수 (초당, 명령별)",
      "description": "v1(db-only)에서도 요청 제한·Idempotency·예약번호 명령은 남는다",
      "datasource": {
