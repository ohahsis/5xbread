# 5XBread 환경 변수. `cp .env.example .env` 후 값을 채운다 (.env 는 git 제외, decisions.md 2장 "비밀 값")
# 로컬(앱 1개)은 application-local.yml 이 이 파일을 읽고, 앱 3개는 compose.full.yaml 이 컨테이너로 넘긴다

# ── 필수 ───────────────────────────────────────────────
# MySQL 앱 계정(fivexbread)·root 비밀번호. 컨테이너를 처음 띄울 때 이 값으로 계정이 만들어진다
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Redis 비밀번호(requirepass). compose 두 개의 Redis 와 앱이 같은 값을 쓴다. 바꾸면 Redis 컨테이너를 다시 만든다
REDIS_PASSWORD=
# JWT 서명 키. UTF-8 32바이트 이상. 비어 있으면 앱이 뜨지 않는다
JWT_SECRET=
# 픽업 QR HMAC 키(C-07). UTF-8 32바이트 이상. 비어 있으면 앱이 뜨지 않는다
PICKUP_SECRET=
# 탈퇴한 번호의 HMAC 키(AU-07 재가입 제한). UTF-8 32바이트 이상. 비어 있으면 앱이 뜨지 않는다. 바꾸면 이전 탈퇴 번호와 비교가 안 된다
WITHDRAWN_PHONE_SECRET=

# ── 사장님 초기 계정 (비우면 경고만 남기고 만들지 않음) ──────────
# 휴대폰 번호(010으로 시작하는 11자리)와 첫 비밀번호(AU-03 규칙). 첫 로그인 때 비밀번호 변경을 강제한다
ADMIN_INITIAL_PHONE=
ADMIN_INITIAL_PASSWORD=

# ── 선택 (비우면 기본값, 주석의 값이 기본값) ─────────────────
# 앱 1개의 BCrypt 동시 계산 상한. 0이면 CPU 수 (decisions.md 6장 "재시작 직후 로그인 폭주")
#PASSWORD_HASH_MAX_CONCURRENCY=0
# 실시간 잔여(/ws) 화면 출처. 쉼표로 여러 개. 비우면 같은 출처만 허용
#REALTIME_ALLOWED_ORIGINS=https://bakery.example
# 스케줄 (Spring cron 6자리, Asia/Seoul). "-" 면 끈다. 확인 실험 때만 바꾼다
#NO_SHOW_CRON=0 0 21 * * *
#OUTBOX_RELAY_CRON=*/5 * * * * *
#OUTBOX_CLEANUP_CRON=0 30 4 * * *
#RECONCILE_CRON=0 */5 * * * *
#WITHDRAWAL_CLEANUP_CRON=0 40 4 * * *
# 예약 재고·한도 검사 방식. redis(v2, 운영) | db-only(v1, 재고·한도 검사를 DB로. 비교 측정용, docker 프로필에서만)
#RESERVATION_MODE=redis
# 모니터링(compose.full.yaml --profile monitoring). 127.0.0.1 에만 열린다
#PROMETHEUS_PORT=9090
#GRAFANA_PORT=3000
#GRAFANA_ADMIN_PASSWORD=admin
